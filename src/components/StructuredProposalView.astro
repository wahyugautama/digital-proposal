---
import type { Client, ProposalDocument } from '../lib/types';
import { calculateMilestones, formatMoney } from '../lib/money';
import { calculateBuilderInvestment, serviceLabel } from '../lib/proposal-builder';
import '../styles/structured-proposal.css';

interface Props { document: ProposalDocument; client: Client; version?: number; publicToken?: string; readonly?: boolean }
const { document, client, version, publicToken, readonly = false } = Astro.props;
const builder = document.builder!;
const services = builder.services.filter(service => service.enabled);
const terms = builder.terms.filter(term => term.enabled && term.title.trim() && term.text.trim());
const hasTimeline = Boolean(builder.timeline.overallDuration.trim() || builder.timeline.phases.length || builder.timeline.note.trim());
let investment: ReturnType<typeof calculateBuilderInvestment> | null = null;
let milestones: ReturnType<typeof calculateMilestones> = [];
try {
  investment = calculateBuilderInvestment(builder);
  milestones = calculateMilestones(investment.totalMinor, builder.milestones);
} catch { /* Incomplete drafts may still be previewed. */ }
const recipient = builder.client.company || client.company || client.name;
const contact = builder.client.contactPerson;
const issueDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(new Date(`${document.issueDate}T00:00:00`));
const expirationDate = new Intl.DateTimeFormat('en', { dateStyle: 'long' }).format(new Date(`${document.expirationDate}T00:00:00`));
---
<article class="proposal structured-proposal">
  <nav class="proposal-nav no-print"><a class="proposal-wordmark" href="#top">SANDIKALA®</a><div><a href="#overview">Overview</a>{services.length > 0 && <a href="#services">Services</a>}{hasTimeline && <a href="#timeline">Timeline</a>}<a href="#investment">Investment</a>{terms.length > 0 && <a href="#terms">Terms</a>}</div><button class="print-button" onclick="window.print()">Print / PDF</button></nav>
  <header class="proposal-hero" id="top">
    <div class="proposal-hero-meta"><span>Proposal {version ? `v${version}` : 'preview'}</span><span>{document.proposalNumber}</span></div>
    <div class="proposal-hero-main"><p>Prepared for<br/><strong>{recipient}</strong>{contact && contact !== recipient && <span class="structured-contact"><br/>{contact}</span>}{builder.client.email && <span class="structured-contact"><br/>{builder.client.email}</span>}</p><h1>{builder.project.title || document.projectName}</h1></div>
    <div class="proposal-hero-foot"><p>Prepared by<br/><strong>Sandikala Studio</strong></p><p>Issued<br/><strong>{issueDate}</strong></p><p>Valid until<br/><strong>{expirationDate}</strong></p></div>
  </header>
  <main class="structured-content">
    {builder.project.overview.trim() && <section class="structured-section" id="overview"><p class="proposal-kicker">The project</p><h2>Project Overview</h2><p class="structured-copy">{builder.project.overview}</p></section>}
    {services.length > 0 && <section class="structured-section" id="services"><p class="proposal-kicker">The engagement</p><h2>Services &amp; Scope</h2><div class="structured-services">{services.map(service => <div class="structured-service"><h3>{serviceLabel(service.type)}</h3><div>{service.scope.filter(item => item.selected && item.title.trim()).map(item => <div class="structured-scope"><strong>{item.title}</strong>{item.description.trim() && <p>{item.description}</p>}</div>)}</div></div>)}</div></section>}
    {hasTimeline && <section class="structured-section" id="timeline"><p class="proposal-kicker">The process</p><h2>Estimated Timeline</h2>{builder.timeline.overallDuration.trim() && <p class="structured-duration">{builder.timeline.overallDuration}</p>}{builder.timeline.phases.length > 0 && <div class="structured-phases">{builder.timeline.phases.map((phase, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><div><strong>{phase.name}</strong>{phase.description.trim() && <p>{phase.description}</p>}</div><em>{phase.duration}</em></div>)}</div>}{builder.timeline.note.trim() && <p class="structured-note">{builder.timeline.note}</p>}</section>}
    <section class="proposal-investment" id="investment"><p class="proposal-kicker">Commercials</p><div class="investment-heading"><h2>Project Investment</h2><strong>{formatMoney(investment?.totalMinor ?? 0, document.currency)} <small>{document.currency}</small></strong></div>{investment && <div class="structured-investment-lines">{[...investment.serviceLines, ...investment.legacyLines].map(line => <div><span>{line.name}</span><strong>{formatMoney(line.amountMinor, document.currency)}</strong></div>)}<div><span>Subtotal</span><strong>{formatMoney(investment.subtotalMinor, document.currency)}</strong></div>{builder.investment.adjustment && <div><span>Package adjustment</span><strong>{formatMoney(investment.packageAdjustmentMinor, document.currency)}</strong></div>}{builder.investment.manualTotalMinor !== null && <div><span>Manual total difference</span><strong>{formatMoney(investment.manualDifferenceMinor, document.currency)}</strong></div>}</div>}</section>
    {builder.milestones.length > 0 && <section class="structured-section" id="payment"><p class="proposal-kicker">Payment schedule</p><h2>Payment Milestones</h2><div class="structured-payments">{builder.milestones.map((milestone, index) => <div><strong>{milestone.percentage}%</strong><span>{milestone.description}</span><em>{formatMoney(milestones[index]?.amountMinor ?? 0, document.currency)}</em></div>)}</div>{milestones.length === 0 && <p class="structured-note no-print">Complete the milestone percentages before publishing.</p>}</section>}
    {terms.length > 0 && <section class="structured-section" id="terms"><p class="proposal-kicker">The agreement</p><h2>Project Terms</h2><div class="structured-terms">{terms.map((term, index) => <div><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{term.title}</h3><p>{term.text}</p></div></div>)}</div></section>}
    <section class="proposal-next" id="acceptance"><p class="proposal-kicker">Next steps</p><h2>Let’s begin.</h2><p>Accept this proposal to confirm the engagement with Sandikala Studio.</p>{publicToken && !readonly ? <div class="response-actions no-print"><button class="proposal-action accept" data-response="accepted">Accept proposal</button><button class="proposal-action" data-response="changes_requested">Request changes</button><button class="proposal-action quiet" data-response="declined">Decline</button></div> : <p class="preview-note no-print">Preview mode · Response controls appear on the published link.</p>}</section>
  </main>
  <footer class="proposal-footer"><span>SANDIKALA®</span><p>Creative direction, brand identity, and digital experiences.</p><span>{document.proposalNumber}</span></footer>
  {publicToken && <dialog class="response-modal no-print" id="response-modal"><form class="response-form" method="post" action={`/api/public/proposals/${publicToken}/respond`}><input type="hidden" name="type"/><input type="hidden" name="submissionId"/><button type="button" class="modal-close" data-modal-close aria-label="Close response form">×</button><p class="proposal-kicker">Confirm</p><h2 data-modal-title>Accept proposal</h2><p data-modal-copy></p><div data-accept-fields><label>Full name<input name="name"/></label><label>Email address<input name="email" type="email"/></label><label class="check-field"><input name="agreed" type="checkbox" value="true"/>I confirm that I have reviewed and agree to this proposal version.</label></div><label data-message-field>Message<textarea name="message" rows="5"></textarea></label><button class="proposal-action accept" data-submit>Submit response</button><small>This records your response; it is not a certified electronic signature.</small></form></dialog>}
</article>
{publicToken && <script>const modal=document.querySelector<HTMLDialogElement>('#response-modal');const form=modal?.querySelector<HTMLFormElement>('form');const config={accepted:{title:'Accept this proposal',copy:'Please confirm your details and agreement to this exact published version.',submit:'Confirm acceptance'},changes_requested:{title:'Request changes',copy:'Tell us what you would like adjusted. We will follow up with a revised draft.',submit:'Send request'},declined:{title:'Decline proposal',copy:'You may share a reason to help us understand your decision.',submit:'Confirm decline'}};document.querySelectorAll<HTMLButtonElement>('[data-response]').forEach(button=>button.addEventListener('click',()=>{if(!modal||!form)return;const type=button.dataset.response as keyof typeof config;const elements=form.elements as typeof form.elements & {type:HTMLInputElement;submissionId:HTMLInputElement;name:HTMLInputElement;email:HTMLInputElement;agreed:HTMLInputElement;message:HTMLTextAreaElement};elements.type.value=type;elements.submissionId.value=crypto.randomUUID();modal.querySelector<HTMLElement>('[data-modal-title]')!.textContent=config[type].title;modal.querySelector<HTMLElement>('[data-modal-copy]')!.textContent=config[type].copy;modal.querySelector<HTMLButtonElement>('[data-submit]')!.textContent=config[type].submit;const accepted=type==='accepted';modal.querySelector<HTMLElement>('[data-accept-fields]')!.hidden=!accepted;modal.querySelector<HTMLElement>('[data-message-field]')!.hidden=accepted;elements.name.required=accepted;elements.email.required=accepted;elements.agreed.required=accepted;elements.message.required=type==='changes_requested';modal.showModal()}));document.querySelector('[data-modal-close]')?.addEventListener('click',()=>modal?.close());</script>}
