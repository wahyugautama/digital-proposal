---
import type { Client, ProposalDocument } from '../lib/types'; import { calculateInvestment, calculateMilestones, formatMoney } from '../lib/money';
interface Props { document:ProposalDocument; client:Client; version?:number; publicToken?:string; readonly?:boolean }
const {document,client,version,publicToken,readonly=false}=Astro.props; const totals=calculateInvestment(document.phases,document.discountMinor,document.taxBasisPoints); let milestones: ReturnType<typeof calculateMilestones> = []; try{milestones=calculateMilestones(totals.totalMinor,document.milestones)}catch{} const sections=document.sections.filter(s=>s.enabled); const contentSections=sections.filter(s=>!['investment','payment','acceptance'].includes(s.kind));
---
<article class="proposal"><nav class="proposal-nav no-print"><a class="proposal-wordmark" href="#top">SANDIKALA®</a><div>{sections.slice(0,5).map(s=><a href={`#${s.id}`}>{s.title}</a>)}</div><button class="print-button" onclick="window.print()">Print / PDF</button></nav><header class="proposal-hero" id="top"><div class="proposal-hero-meta"><span>Proposal {version?`v${version}`:'preview'}</span><span>{document.proposalNumber}</span></div><div class="proposal-hero-main"><p>Prepared for<br/><strong>{client.company||client.name}</strong></p><h1>{document.projectName}</h1></div><div class="proposal-hero-foot"><p>Prepared by<br/><strong>Sandikala Studio</strong></p><p>Issued<br/><strong>{new Intl.DateTimeFormat('en',{dateStyle:'long'}).format(new Date(`${document.issueDate}T00:00:00`))}</strong></p><p>Valid until<br/><strong>{new Intl.DateTimeFormat('en',{dateStyle:'long'}).format(new Date(`${document.expirationDate}T00:00:00`))}</strong></p></div></header><main class="proposal-content"><aside class="proposal-toc no-print"><p>Contents</p>{sections.map((s,i)=><a href={`#${s.id}`}><span>{String(i+1).padStart(2,'0')}</span>{s.title}</a>)}</aside><div class="proposal-sections">{contentSections.map((section,index)=><section class="proposal-section" id={section.id}><div class="proposal-section-index">{String(index+1).padStart(2,'0')}</div><div><p class="proposal-kicker">{section.kind==='scope'?'The engagement':section.kind==='timeline'?'The process':'Context & direction'}</p><h2>{section.title}</h2><div class:list={['proposal-copy',section.kind==='scope'&&'proposal-list']} set:html={section.content}/></div></section>)}<section class="proposal-investment" id="investment"><p class="proposal-kicker">Commercials</p><div class="investment-heading"><h2>Investment</h2><strong>{formatMoney(totals.totalMinor,document.currency)} <small>{document.currency}</small></strong></div>{document.pricingDisplay==='phases'&&<div class="phase-list">{document.phases.map((phase,index)=><div><span>{String(index+1).padStart(2,'0')}</span><p><strong>{phase.name}</strong><small>{phase.description}</small></p><b>{formatMoney(phase.amountMinor,document.currency)}</b></div>)}</div>}<p class="investment-note">The investment reflects the agreed phases, scope, and deliverables described in this proposal.</p></section><section class="proposal-section" id="payment"><div class="proposal-section-index">—</div><div><p class="proposal-kicker">Payment terms</p><h2>Built around project milestones.</h2><div class="milestone-list">{milestones.map(item=><div><strong>{item.percentage}%</strong><p>{item.description}</p><span>{formatMoney(item.amountMinor,document.currency)}</span></div>)}</div></div></section>{sections.filter(s=>s.kind==='acceptance').map(s=><section class="proposal-next"><p class="proposal-kicker">Next steps</p><h2>{s.title}</h2><p>{s.content}</p>{publicToken&&!readonly?<div class="response-actions no-print"><button class="proposal-action accept" data-response="accepted">Accept proposal</button><button class="proposal-action" data-response="changes_requested">Request changes</button><button class="proposal-action quiet" data-response="declined">Decline</button></div>:<p class="preview-note no-print">Preview mode · Response controls appear on the published link.</p>}</section>)}</div></main><footer class="proposal-footer"><span>SANDIKALA®</span><p>Creative direction, brand identity, and digital experiences.</p><span>{document.proposalNumber}</span></footer>{publicToken&&<dialog class="response-modal no-print" id="response-modal"><form class="response-form" method="post" action={`/api/public/proposals/${publicToken}/respond`}><input type="hidden" name="type"/><input type="hidden" name="submissionId"/><button type="button" class="modal-close" data-modal-close>×</button><p class="proposal-kicker" data-modal-kicker>Confirm</p><h2 data-modal-title>Accept proposal</h2><p data-modal-copy></p><div data-accept-fields><label>Full name<input name="name"/></label><label>Email address<input name="email" type="email"/></label><label class="check-field"><input name="agreed" type="checkbox" value="true"/>I confirm that I have reviewed and agree to this proposal version.</label></div><label data-message-field>Message<textarea name="message" rows="5"></textarea></label><button class="proposal-action accept" data-submit>Submit response</button><small>This records your response; it is not a certified electronic signature.</small></form></dialog>}</article>{publicToken&&<script define:vars={{publicToken}}>const modal=document.querySelector('#response-modal');const form=modal?.querySelector('form');const config={accepted:{title:'Accept this proposal',copy:'Please confirm your details and agreement to this exact published version.',submit:'Confirm acceptance'},changes_requested:{title:'Request changes',copy:'Tell us what you would like adjusted. We will follow up with a revised draft.',submit:'Send request'},declined:{title:'Decline proposal',copy:'You may share a reason to help us understand your decision.',submit:'Confirm decline'}};document.querySelectorAll('[data-response]').forEach(button=>button.addEventListener('click',()=>{const type=button.dataset.response;form.elements.type.value=type;form.elements.submissionId.value=crypto.randomUUID();modal.querySelector('[data-modal-title]').textContent=config[type].title;modal.querySelector('[data-modal-copy]').textContent=config[type].copy;modal.querySelector('[data-submit]').textContent=config[type].submit;modal.querySelector('[data-accept-fields]').hidden=type!=='accepted';modal.querySelector('[data-message-field]').hidden=type==='accepted';form.elements.name.required=type==='accepted';form.elements.email.required=type==='accepted';form.elements.agreed.required=type==='accepted';form.elements.message.required=type==='changes_requested';modal.showModal()}));document.querySelector('[data-modal-close]')?.addEventListener('click',()=>modal.close());</script>}
