---
import AdminLayout from '../layouts/AdminLayout.astro'; import { createSupabaseAdmin } from '../lib/server/supabase'; const {data:settings}=await createSupabaseAdmin().from('studio_settings').select('*').limit(1).maybeSingle();
---
<AdminLayout title="Studio settings" eyebrow="Workspace"><form class="settings-card" method="post" action="/api/admin/settings"><div><h2>Studio identity</h2><p>Defaults shown across proposals and client correspondence.</p></div><label class="form-field"><span>Studio name</span><input name="studioName" value={settings?.studio_name??'Sandikala Studio'} required/></label><label class="form-field"><span>Contact email</span><input name="email" type="email" value={settings?.email??''}/></label><label class="form-field"><span>Address</span><textarea name="address" rows="3">{settings?.address??''}</textarea></label><label class="form-field"><span>Default currency</span><select name="defaultCurrency"><option selected={settings?.default_currency==='USD'}>USD</option><option selected={settings?.default_currency==='IDR'}>IDR</option></select></label><label class="form-field"><span>Default terms</span><textarea name="defaultTerms" rows="7">{settings?.default_terms??''}</textarea></label><button class="button button-primary">Save settings</button></form></AdminLayout>
