---
if (Astro.locals.user) return Astro.redirect('/');
import '../styles/main.css';
import '../styles/login-minimal.css';
import '../styles/product-brand.css';
import ProductWordmark from '../components/ProductWordmark.astro';
import ProductAttribution from '../components/ProductAttribution.astro';
import { PRODUCT } from '../lib/product';
const hasError = Astro.url.searchParams.has('error');
const next = Astro.url.searchParams.get('next') ?? '/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <meta name="description" content={PRODUCT.description} />
    <meta name="application-name" content={PRODUCT.name} />
    <meta property="og:title" content={`Sign in — ${PRODUCT.name}`} />
    <meta property="og:description" content={PRODUCT.description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Sign in — {PRODUCT.name}</title>
  </head>
  <body class="login-simple-body">
    <main class="login-simple-main">
      <div class="login-simple-content">
      <h1 class="login-simple-wordmark"><ProductWordmark /></h1>
      <form class="login-simple-form" action="/api/auth/login" method="post">
        <input type="hidden" name="next" value={next} />
        {hasError && <p class="login-simple-error" role="alert">Incorrect email or password, or this account is not authorized.</p>}
        <label class="login-simple-field">
          <span>Email</span>
          <input name="email" type="email" inputmode="email" autocomplete="username" autocapitalize="none" spellcheck="false" required />
        </label>
        <label class="login-simple-field">
          <span>Password</span>
          <input name="password" type="password" autocomplete="current-password" minlength="8" required />
        </label>
        <button class="login-simple-submit" type="submit">Sign in</button>
      </form>
      </div>
    </main>
    <footer class="login-simple-footer"><ProductAttribution /></footer>
  </body>
</html>
