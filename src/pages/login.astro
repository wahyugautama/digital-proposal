---
if (Astro.locals.user) return Astro.redirect('/dashboard');
import '../styles/main.css';
const hasError = Astro.url.searchParams.has('error');
const next = Astro.url.searchParams.get('next') ?? '/dashboard';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Sign in · Sandikala Proposals</title></head><body class="login-body"><main class="login-shell"><section class="login-intro"><a class="login-logo" href="/">SANDIKALA®</a><div><p class="eyebrow light">Internal workspace</p><h1>Proposals with clarity, craft, and intention.</h1><p>Create considered client experiences—from first scope to final approval.</p></div><p class="login-footnote">Private system · Authorized access only</p></section><section class="login-panel"><form class="login-form" action="/api/auth/login" method="post"><p class="eyebrow">Welcome back</p><h2>Sign in to your workspace</h2><p>Use your authorized Sandikala Studio account.</p>{hasError && <div class="alert alert-error" role="alert">The email or password is incorrect, or this account is not authorized.</div>}<input type="hidden" name="next" value={next}/><label class="form-field"><span>Email address</span><input name="email" type="email" autocomplete="email" required placeholder="you@sandikala.studio"/></label><label class="form-field"><span>Password</span><input name="password" type="password" autocomplete="current-password" minlength="8" required placeholder="••••••••"/></label><button class="button button-primary button-full" type="submit">Sign in <span>→</span></button><small>There is no public registration. Contact the studio owner if you need access.</small></form></section></main></body></html>
