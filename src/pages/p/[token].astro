---
import ProposalLayout from '../../layouts/ProposalLayout.astro'; import ProposalView from '../../components/ProposalView.astro'; import StructuredProposalView from '../../components/StructuredProposalView.astro'; import { getPublicProposal } from '../../lib/server/proposals'; import { createSupabaseAdmin } from '../../lib/server/supabase'; import { isLikelyBot } from '../../lib/server/security';
const access=await getPublicProposal(Astro.params.token!); if(!access)return new Response('This proposal link is invalid, expired, or has been revoked.',{status:404}); const version=access.proposal_versions; const proposal=access.proposals; const ua=Astro.request.headers.get('user-agent')??''; if(!isLikelyBot(ua)){const db=createSupabaseAdmin();const{error:eventError}=await db.from('proposal_events').insert({proposal_id:proposal.id,version_id:version.id,event_type:'viewed',metadata:{approximate:true}});const{error:accessError}=await db.from('proposal_access_tokens').update({last_accessed_at:new Date().toISOString()}).eq('id',access.id);let statusError=null;if(['published','viewed'].includes(proposal.status)){({error:statusError}=await db.from('proposals').update({status:'viewed'}).eq('id',proposal.id).neq('status','accepted'));}if(eventError||accessError||statusError)console.error('Unable to record proposal view metadata.');}
const success=Astro.url.searchParams.get('response');
---
<ProposalLayout title={version.snapshot.projectName}>{success&&<div class="response-confirmation no-print"><strong>{success==='accepted'?'Proposal accepted. Thank you.':'Your response has been sent.'}</strong><span>Sandikala Studio will follow up shortly.</span></div>}{version.snapshot.builder ? <StructuredProposalView document={version.snapshot} client={proposal.clients} version={version.version_number} publicToken={Astro.params.token}/> : <ProposalView document={version.snapshot} client={proposal.clients} version={version.version_number} publicToken={Astro.params.token}/>}</ProposalLayout>
