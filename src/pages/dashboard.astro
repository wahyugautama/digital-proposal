---
import AdminLayout from '../layouts/AdminLayout.astro'; import StatusBadge from '../components/ui/StatusBadge.astro'; import EmptyState from '../components/EmptyState.astro'; import { createSupabaseAdmin } from '../lib/server/supabase'; import { formatMoney } from '../lib/money';
const { data: proposals = [] } = await createSupabaseAdmin().from('proposals').select('*, clients(name,company)').is('archived_at', null).order('updated_at', { ascending: false }).limit(8); const all = proposals ?? []; const counts = { total: all.length, draft: all.filter(p=>p.status==='draft').length, published: all.filter(p=>['published','viewed','changes_requested'].includes(p.status)).length, accepted: all.filter(p=>p.status==='accepted').length };
---
<AdminLayout title="Good work starts with a clear proposal." eyebrow="Overview"><div slot="actions"><a class="button button-primary" href="/proposals/new">New proposal <span>＋</span></a></div><section class="metric-grid"><article class="metric-card"><span>Total proposals</span><strong>{counts.total}</strong><small>All active proposals</small></article><article class="metric-card"><span>In draft</span><strong>{counts.draft}</strong><small>Waiting to be finished</small></article><article class="metric-card"><span>Published</span><strong>{counts.published}</strong><small>Currently with clients</small></article><article class="metric-card metric-dark"><span>Accepted</span><strong>{counts.accepted}</strong><small>Confirmed engagements</small></article></section><section class="panel"><div class="panel-header"><div><p class="eyebrow">Recent activity</p><h2>Proposals</h2></div><a class="text-link" href="/proposals">View all →</a></div>{all.length ? <div class="table-wrap"><table><thead><tr><th>Proposal</th><th>Client</th><th>Investment</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>{all.map(p=><tr><td><a class="table-primary" href={`/proposals/${p.id}/edit`}>{p.project_name}<small>{p.proposal_number} · {p.proposal_type}</small></a></td><td>{p.clients?.company || p.clients?.name}</td><td>{formatMoney(p.total_minor,p.currency)}</td><td><StatusBadge status={p.status}/></td><td>{new Intl.DateTimeFormat('en',{dateStyle:'medium'}).format(new Date(p.updated_at))}</td><td><a class="row-action" href={`/proposals/${p.id}/preview`}>Preview</a></td></tr>)}</tbody></table></div> : <EmptyState title="Create your first proposal" text="Start from a proven Sandikala template and tailor it for your client." href="/proposals/new" action="New proposal"/>}</section></AdminLayout>
