---
import '../../../styles/main.css'; import ProposalEditor from '../../../components/ProposalEditor.vue'; import { getPublicAppUrl } from '../../../lib/server/app-url'; import { createSupabaseAdmin } from '../../../lib/server/supabase'; import { decryptAccessToken } from '../../../lib/server/security';
const db=createSupabaseAdmin(); const {data:proposal}=await db.from('proposals').select('*, clients(*)').eq('id',Astro.params.id).single(); if(!proposal)return new Response('Proposal not found',{status:404}); const {data:clients=[]}=await db.from('clients').select('id,name,company,email,phone').is('archived_at',null).order('name'); const {data:activeAccess}=await db.from('proposal_access_tokens').select('encrypted_token').eq('proposal_id',proposal.id).is('revoked_at',null).gt('expires_at',new Date().toISOString()).order('created_at',{ascending:false}).limit(1).maybeSingle(); const activeToken=activeAccess?.encrypted_token?await decryptAccessToken(activeAccess.encrypted_token):null; const activeShareUrl=activeToken?`${getPublicAppUrl()}/p/${activeToken}`:null;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Edit {proposal.project_name} · Sandikala Proposals</title></head><body class="editor-body"><header class="editor-topbar"><a class="editor-brand" href="/proposals"><span class="brand-mark">S</span><span>Proposals</span></a><div class="editor-title"><strong>{proposal.project_name}</strong><small>{proposal.proposal_number} · {proposal.status.replace('_',' ')}</small></div><a class="text-link" href="/proposals">← All proposals</a></header><ProposalEditor client:load proposalId={proposal.id} initialDocument={proposal.draft_document} clients={clients??[]} initialClientId={proposal.client_id} status={proposal.status} activeShareUrl={activeShareUrl}/></body></html>
