---
import '../../../styles/main.css'; import ProposalEditor from '../../../components/ProposalEditor.vue'; import { getPublicAppUrl } from '../../../lib/server/app-url'; import { logProposalPageError, parseStoredProposalDocument } from '../../../lib/server/proposals'; import { createSupabaseAdmin } from '../../../lib/server/supabase'; import { decryptAccessToken } from '../../../lib/server/security';
const db=createSupabaseAdmin(); const {data:proposal,error:proposalError}=await db.from('proposals').select('*, clients(*)').eq('id',Astro.params.id).maybeSingle(); if(proposalError){logProposalPageError('edit',Astro.params.id,proposalError);return new Response('Unable to load proposal editor.',{status:500})} if(!proposal)return new Response('Proposal not found',{status:404}); let document; try{document=parseStoredProposalDocument(proposal.draft_document)}catch(error){logProposalPageError('edit',Astro.params.id,error);return new Response('Unable to load proposal editor.',{status:500})} const {data:clients=[],error:clientsError}=await db.from('clients').select('id,name,company,email,phone').is('archived_at',null).order('name'); if(clientsError){logProposalPageError('edit',Astro.params.id,clientsError);return new Response('Unable to load proposal editor.',{status:500})} const {data:activeAccess,error:accessError}=await db.from('proposal_access_tokens').select('encrypted_token').eq('proposal_id',proposal.id).is('revoked_at',null).gt('expires_at',new Date().toISOString()).order('created_at',{ascending:false}).limit(1).maybeSingle(); if(accessError)logProposalPageError('edit',Astro.params.id,accessError); let activeToken=null; if(activeAccess?.encrypted_token){try{activeToken=await decryptAccessToken(activeAccess.encrypted_token)}catch(error){logProposalPageError('edit',Astro.params.id,error)}} const activeShareUrl=activeToken?`${getPublicAppUrl()}/p/${activeToken}`:null;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex"/><title>Edit {proposal.project_name} · Sandikala Proposals</title></head><body class="editor-body"><header class="editor-topbar"><a class="editor-brand" href="/proposals"><span class="brand-mark">S</span><span>Proposals</span></a><div class="editor-title"><strong>{proposal.project_name}</strong><small>{proposal.proposal_number} · {proposal.status.replace('_',' ')}</small></div><a class="text-link" href="/proposals">← All proposals</a></header><ProposalEditor client:load proposalId={proposal.id} initialDocument={document} clients={clients??[]} initialClientId={proposal.client_id} status={proposal.status} activeShareUrl={activeShareUrl}/></body></html>
