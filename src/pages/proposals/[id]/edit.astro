---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import ProposalForm from '../../../components/ProposalForm.vue';
import { getPublicAppUrl } from '../../../lib/server/app-url';
import { logProposalPageError, parseStoredProposalDocument } from '../../../lib/server/proposals';
import { createSupabaseAdmin } from '../../../lib/server/supabase';
import { decryptAccessToken } from '../../../lib/server/security';

const db = createSupabaseAdmin();
const { data: proposal, error: proposalError } = await db.from('proposals').select('*,clients(*)').eq('id', Astro.params.id).maybeSingle();
if (proposalError) { logProposalPageError('edit', Astro.params.id, proposalError); return new Response('Unable to load proposal editor.', { status: 500 }); }
if (!proposal) return new Response('Proposal not found.', { status: 404 });
let document;
try { document = parseStoredProposalDocument(proposal.draft_document); }
catch (error) { logProposalPageError('edit', Astro.params.id, error); return new Response('Unable to load proposal editor.', { status: 500 }); }
const [{ data: clients, error: clientsError }, { data: settings }, { data: activeAccess, error: accessError }] = await Promise.all([
  db.from('clients').select('id,name,company,email,phone').is('archived_at', null).order('name'),
  db.from('studio_settings').select('default_terms').limit(1).maybeSingle(),
  db.from('proposal_access_tokens').select('encrypted_token').eq('proposal_id', proposal.id).is('revoked_at', null).gt('expires_at', new Date().toISOString()).order('created_at', { ascending: false }).limit(1).maybeSingle(),
]);
if (clientsError) { logProposalPageError('edit', Astro.params.id, clientsError); return new Response('Unable to load proposal editor.', { status: 500 }); }
if (accessError) logProposalPageError('edit', Astro.params.id, accessError);
let activeToken: string | null = null;
if (activeAccess?.encrypted_token) {
  try { activeToken = await decryptAccessToken(activeAccess.encrypted_token); }
  catch (error) { logProposalPageError('edit', Astro.params.id, error); }
}
const activeShareUrl = activeToken ? `${getPublicAppUrl()}/p/${activeToken}` : null;
---
<AdminLayout documentTitle={`Edit ${proposal.project_name}`} showNewAction={false}>
  <ProposalForm client:load initialDocument={document} clients={clients ?? []} initialClientId={proposal.client_id} initialClient={proposal.clients} proposalId={proposal.id} status={proposal.status} activeShareUrl={activeShareUrl} studioTerms={settings?.default_terms ?? ''} />
</AdminLayout>
