---
import ProposalLayout from '../../../layouts/ProposalLayout.astro'; import ProposalView from '../../../components/ProposalView.astro'; import StructuredProposalView from '../../../components/StructuredProposalView.astro'; import { createSupabaseAdmin } from '../../../lib/server/supabase'; import { logProposalPageError, parseStoredProposalDocument, sanitizeDocument } from '../../../lib/server/proposals';
const {data:proposal,error}=await createSupabaseAdmin().from('proposals').select('*,clients(*)').eq('id',Astro.params.id).maybeSingle(); if(error){logProposalPageError('preview',Astro.params.id,error);return new Response('Unable to load proposal preview.',{status:500})} if(!proposal)return new Response('Not found',{status:404});
let document; try{document=sanitizeDocument(parseStoredProposalDocument(proposal.draft_document))}catch(error){logProposalPageError('preview',Astro.params.id,error);return new Response('Unable to render proposal preview.',{status:500})} if(!proposal.clients){logProposalPageError('preview',Astro.params.id,new Error('MissingClientRelation'));return new Response('Unable to render proposal preview.',{status:500})}
---
<ProposalLayout title={`Preview — ${proposal.project_name}`}><div class="preview-bar no-print"><span>Draft preview</span><p>This is not the active client-facing version.</p><a href={`/proposals/${proposal.id}/edit`}>Back to editor</a></div>{document.builder ? <StructuredProposalView document={document} client={proposal.clients} readonly/> : <ProposalView document={document} client={proposal.clients} readonly/>}</ProposalLayout>
