---
import AdminLayout from '../../layouts/AdminLayout.astro'; import StatusBadge from '../../components/ui/StatusBadge.astro'; import EmptyState from '../../components/EmptyState.astro'; import { createSupabaseAdmin } from '../../lib/server/supabase'; import { formatMoney } from '../../lib/money';
const status = Astro.url.searchParams.get('status') ?? 'all'; const search = Astro.url.searchParams.get('q') ?? ''; let query = createSupabaseAdmin().from('proposals').select('*, clients(name,company)').is('archived_at',null).order('updated_at',{ascending:false}); if(status!=='all') query=query.eq('status',status); if(search) query=query.ilike('project_name',`%${search}%`); const {data:proposals=[]}=await query;
---
<AdminLayout title="Proposals" eyebrow="Workspace"><a slot="actions" class="button button-primary" href="/proposals/new">New proposal ＋</a><div class="toolbar"><form class="search-form"><input type="search" name="q" value={search} placeholder="Search project name…"/><select name="status" onchange="this.form.submit()"><option value="all">All statuses</option>{['draft','published','viewed','changes_requested','accepted','declined','expired'].map(s=><option value={s} selected={status===s}>{s.replace('_',' ')}</option>)}</select><button class="button button-secondary">Filter</button></form></div><section class="panel">{proposals?.length ? <div class="table-wrap"><table><thead><tr><th>Proposal</th><th>Client</th><th>Type</th><th>Investment</th><th>Status</th><th>Updated</th><th></th></tr></thead><tbody>{proposals.map(p=><tr><td><a class="table-primary" href={`/proposals/${p.id}/edit`}>{p.project_name}<small>{p.proposal_number}</small></a></td><td>{p.clients?.company||p.clients?.name}</td><td class="capitalize">{p.proposal_type}</td><td>{formatMoney(p.total_minor,p.currency)}</td><td><StatusBadge status={p.status}/></td><td>{new Intl.DateTimeFormat('en',{dateStyle:'medium'}).format(new Date(p.updated_at))}</td><td class="table-actions"><a href={`/proposals/${p.id}/edit`}>Edit</a><a href={`/proposals/${p.id}/preview`}>Preview</a></td></tr>)}</tbody></table></div>:<EmptyState title="No proposals found" text="Create a proposal or change your filters." href="/proposals/new" action="New proposal"/>}</section></AdminLayout>
