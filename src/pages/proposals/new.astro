---
import AdminLayout from '../../layouts/AdminLayout.astro';
import ProposalForm from '../../components/ProposalForm.vue';
import { makeBuilderDocument } from '../../lib/proposal-builder';
import { createSupabaseAdmin } from '../../lib/server/supabase';

const db = createSupabaseAdmin();
const [{ data: clients, error: clientsError }, { data: settings, error: settingsError }] = await Promise.all([
  db.from('clients').select('id,name,company,email,phone').is('archived_at', null).order('name'),
  db.from('studio_settings').select('default_currency,default_terms').limit(1).maybeSingle(),
]);
if (clientsError || settingsError) return new Response('Unable to load proposal builder.', { status: 500 });
const document = makeBuilderDocument(settings?.default_terms ?? '');
document.currency = settings?.default_currency === 'IDR' ? 'IDR' : 'USD';
---
<AdminLayout documentTitle="New proposal" showNewAction={false}>
  <ProposalForm client:load initialDocument={document} clients={clients ?? []} initialClientId="" proposalId={null} status="draft" activeShareUrl={null} />
</AdminLayout>
