---
import AdminLayout from '../../layouts/AdminLayout.astro'; import { createSupabaseAdmin } from '../../lib/server/supabase'; import { initialTemplates } from '../../lib/templates';
const {data:clients=[]}=await createSupabaseAdmin().from('clients').select('id,name,company,email').is('archived_at',null).order('name');
---
<AdminLayout title="Create proposal" eyebrow="New proposal"><a slot="actions" class="button button-secondary" href="/proposals">Cancel</a><form class="creation-layout" method="post" action="/api/admin/proposals"><section class="creation-main"><div class="section-heading"><span class="step-number">01</span><div><h2>Choose a starting point</h2><p>Each template provides a proven structure. Every detail remains editable.</p></div></div><div class="template-grid">{initialTemplates.map((template,index)=><label class="template-option"><input type="radio" name="templateIndex" value={index} required checked={index===0}/><span class="template-card"><span class="template-icon">{template.document.proposalType==='quick'?'Q':'P'}</span><strong>{template.name}</strong><small>{template.document.proposalType==='quick'?'Quick quotation':'Full proposal'} · {template.document.sections.length} sections</small><span class="template-select">Use template →</span></span></label>)}</div></section><aside class="creation-aside"><div class="section-heading compact"><span class="step-number">02</span><div><h2>Assign a client</h2><p>Who is this proposal for?</p></div></div>{clients?.length?<><label class="form-field"><span>Client</span><select name="clientId" required><option value="">Select a client…</option>{clients.map(c=><option value={c.id}>{c.company||c.name} — {c.email}</option>)}</select></label><button class="button button-primary button-full">Create and edit →</button></>:<div class="inline-empty"><p>Add a client before creating a proposal.</p><a class="button button-primary" href="/clients">Add client</a></div>}</aside></form></AdminLayout>
