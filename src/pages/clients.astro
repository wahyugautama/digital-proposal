---
import AdminLayout from '../layouts/AdminLayout.astro'; import EmptyState from '../components/EmptyState.astro'; import { createSupabaseAdmin } from '../lib/server/supabase';
const {data:clients=[]}=await createSupabaseAdmin().from('clients').select('*, proposals(count)').is('archived_at',null).order('created_at',{ascending:false});
---
<AdminLayout title="Clients" eyebrow="Relationships"><button slot="actions" class="button button-primary" data-open-client>New client ＋</button><section class="panel">{clients?.length?<div class="table-wrap"><table><thead><tr><th>Name</th><th>Company</th><th>Email</th><th>Proposals</th><th>Added</th></tr></thead><tbody>{clients.map(c=><tr><td class="table-primary">{c.name}</td><td>{c.company||'—'}</td><td><a href={`mailto:${c.email}`}>{c.email}</a></td><td>{c.proposals?.[0]?.count??0}</td><td>{new Intl.DateTimeFormat('en',{dateStyle:'medium'}).format(new Date(c.created_at))}</td></tr>)}</tbody></table></div>:<EmptyState title="No clients yet" text="Add a client before creating their first proposal."/>}</section><dialog class="modal" id="client-modal"><form method="post" action="/api/admin/clients" class="modal-card"><div class="modal-heading"><div><p class="eyebrow">New relationship</p><h2>Add client</h2></div><button type="button" class="icon-button" data-close-client>×</button></div><label class="form-field"><span>Contact name</span><input name="name" required minlength="2"/></label><label class="form-field"><span>Company</span><input name="company"/></label><label class="form-field"><span>Email</span><input name="email" type="email" required/></label><label class="form-field"><span>Phone</span><input name="phone"/></label><div class="modal-actions"><button type="button" class="button button-secondary" data-close-client>Cancel</button><button class="button button-primary">Save client</button></div></form></dialog><script>const modal=document.querySelector<HTMLDialogElement>('#client-modal');document.querySelector('[data-open-client]')?.addEventListener('click',()=>modal?.showModal());document.querySelectorAll('[data-close-client]').forEach(el=>el.addEventListener('click',()=>modal?.close()));</script></AdminLayout>
