# Supabase project URL from Project Settings > API.
PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
# Supabase publishable/anon key. Database access is still governed by RLS.
PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-publishable-key

# Private server credential. Never prefix this variable with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-secret-key
# Base64-encoded 32-byte AES key used only to encrypt recoverable proposal links.
PROPOSAL_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
# Comma-separated, case-insensitive list. Public registration is disabled.
ADMIN_EMAIL_ALLOWLIST=admin@example.com

# Canonical application origin used to generate proposal sharing links.
PUBLIC_APP_URL=https://proposals.sandikala.studio
